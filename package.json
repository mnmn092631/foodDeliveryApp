{
  "name": "FoodDeliveryApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "codepush:android": "appcenter codepush release-react -a mnmn092631-gmail.com/food-delivery-app-android -d Staging --sourcemap-output --output-dir ./build -m -t 1.0",
    "codepush:ios": "appcenter codepush release-react -a mnmn092631-gmail.com/food-delivery-app-ios -d Staging --sourcemap-output --output-dir ./build -m -t 1.0",
    "bundle:android": "react-native bundle --assets-dest build/CodePush --bundle-output build/CodePush/index.android.bundle --dev false --entry-file index.js --platform android --sourcemap-output build/CodePush/index.android.bundle.map",
    "bundle:ios": "react-native bundle --assets-dest build/CodePush --bundle-output build/CodePush/main.jsbundle --dev false --entry-file index.js --platform ios --sourcemap-output build/CodePush/main.jsbundle.map",
    "appcenter-android-key": "appcenter codepush deployment list -a mnmn092631-gmail.com/food-delivery-app-android -k",
    "appcenter-ios-key": "appcenter codepush deployment list -a mnmn092631-gmail.com/food-delivery-app-ios -k"
  },
  "dependencies": {
    "@mj-studio/react-native-naver-map": "^1.5.10",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "@react-native-firebase/analytics": "^21.6.1",
    "@react-native-firebase/app": "^21.6.1",
    "@react-native-firebase/messaging": "^21.6.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@reduxjs/toolkit": "^2.5.0",
    "appcenter": "5.0.2",
    "appcenter-analytics": "5.0.2",
    "appcenter-crashes": "5.0.2",
    "axios": "^1.7.9",
    "patch-package": "^8.0.0",
    "react": "18.3.1",
    "react-native": "^0.76.6",
    "react-native-code-push": "^9.0.1",
    "react-native-config": "^1.5.3",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-fast-image": "^8.6.3",
    "react-native-flipper": "^0.273.0",
    "react-native-image-crop-picker": "^0.42.0",
    "react-native-image-resizer": "^1.4.5",
    "react-native-keyboard-aware-scrollview": "^2.1.0",
    "react-native-permissions": "^5.2.4",
    "react-native-push-notification": "^8.1.1",
    "react-native-safe-area-context": "^5.1.0",
    "react-native-screens": "^4.0.0",
    "react-native-splash-screen": "^3.3.0",
    "react-native-vector-icons": "^10.2.0",
    "react-redux": "^9.2.0",
    "redux-flipper": "^2.0.3",
    "rn-flipper-async-storage-advanced": "^1.0.5",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.6",
    "@react-native/eslint-config": "0.76.6",
    "@react-native/metro-config": "0.76.6",
    "@react-native/typescript-config": "0.76.6",
    "@types/react": "^18.2.6",
    "@types/react-native-push-notification": "^8.1.4",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "18.3.1",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
